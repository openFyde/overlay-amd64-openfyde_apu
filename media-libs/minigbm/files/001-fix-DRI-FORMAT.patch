Index: minigbm/dri.h
===================================================================
--- minigbm.orig/dri.h
+++ minigbm/dri.h
@@ -8,6 +8,46 @@
 
 #include "drv.h"
 
+/*
+ * Mesa >= 25 changed the DRI image "format" argument of dri_create_image() &
+ * friends: it is no longer the legacy 0x100x __DRI_IMAGE_FORMAT_* token but the
+ * gallium "enum pipe_format" value (see Mesa's src/loader/loader_dri_helper.h,
+ * which now #defines __DRI_IMAGE_FORMAT_<x> as PIPE_FORMAT_<y>, and
+ * dri2_get_mapping_by_format() in the megadriver which matches on it). Passing
+ * the old values makes the lookup miss and image creation return NULL.
+ *
+ * enum pipe_format is build-generated (src/util/format/u_format_gen.h) and not
+ * a public header, so the required values are mirrored here. They are the
+ * ordinals from the Mesa being linked against (currently 26.1.3) and MUST be
+ * kept in sync with it: if Mesa is upgraded, regenerate with
+ *   python3 src/util/format/u_format_table.py src/util/format/u_format.yaml --enums
+ * and read the enum values. The PIPE_FORMAT_* each maps to is shown alongside.
+ */
+#define __DRI_IMAGE_FORMAT_RGB565       309  /* PIPE_FORMAT_B5G6R5_UNORM */
+#define __DRI_IMAGE_FORMAT_XRGB8888     282  /* PIPE_FORMAT_B8G8R8X8_UNORM */
+#define __DRI_IMAGE_FORMAT_ARGB8888     105  /* PIPE_FORMAT_B8G8R8A8_UNORM */
+#define __DRI_IMAGE_FORMAT_ABGR8888     84   /* PIPE_FORMAT_R8G8B8A8_UNORM */
+#define __DRI_IMAGE_FORMAT_XBGR8888     293  /* PIPE_FORMAT_R8G8B8X8_UNORM */
+#define __DRI_IMAGE_FORMAT_R8           81   /* PIPE_FORMAT_R8_UNORM */
+#define __DRI_IMAGE_FORMAT_GR88         82   /* PIPE_FORMAT_R8G8_UNORM */
+#define __DRI_IMAGE_FORMAT_NONE         0    /* PIPE_FORMAT_NONE */
+#define __DRI_IMAGE_FORMAT_XRGB2101010  445  /* PIPE_FORMAT_B10G10R10X2_UNORM */
+#define __DRI_IMAGE_FORMAT_ARGB2101010  120  /* PIPE_FORMAT_B10G10R10A2_UNORM */
+#define __DRI_IMAGE_FORMAT_SARGB8       351  /* PIPE_FORMAT_BGRA8888_SRGB */
+#define __DRI_IMAGE_FORMAT_ARGB1555     297  /* PIPE_FORMAT_B5G5R5A1_UNORM */
+#define __DRI_IMAGE_FORMAT_R16          57   /* PIPE_FORMAT_R16_UNORM */
+#define __DRI_IMAGE_FORMAT_GR1616       58   /* PIPE_FORMAT_R16G16_UNORM */
+#define __DRI_IMAGE_FORMAT_YUYV         127  /* PIPE_FORMAT_YUYV */
+#define __DRI_IMAGE_FORMAT_XBGR2101010  310  /* PIPE_FORMAT_R10G10B10X2_UNORM */
+#define __DRI_IMAGE_FORMAT_ABGR2101010  114  /* PIPE_FORMAT_R10G10B10A2_UNORM */
+#define __DRI_IMAGE_FORMAT_SABGR8       347  /* PIPE_FORMAT_RGBA8888_SRGB */
+#define __DRI_IMAGE_FORMAT_UYVY         125  /* PIPE_FORMAT_UYVY */
+#define __DRI_IMAGE_FORMAT_XBGR16161616F 450 /* PIPE_FORMAT_R16G16B16X16_FLOAT */
+#define __DRI_IMAGE_FORMAT_ABGR16161616F 56  /* PIPE_FORMAT_R16G16B16A16_FLOAT */
+#define __DRI_IMAGE_FORMAT_SXRGB8       352  /* PIPE_FORMAT_BGRX8888_SRGB */
+#define __DRI_IMAGE_FORMAT_ABGR16161616 60   /* PIPE_FORMAT_R16G16B16A16_UNORM */
+#define __DRI_IMAGE_FORMAT_XBGR16161616 448  /* PIPE_FORMAT_R16G16B16X16_UNORM */
+
 struct dri_driver;
 
 void *dri_dlopen(const char *dri_so_path);
