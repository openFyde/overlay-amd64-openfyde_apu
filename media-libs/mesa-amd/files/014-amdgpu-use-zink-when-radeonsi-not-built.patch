+    * (GL-on-Vulkan via radv). Map amdgpu -> zink so every process (gralloc,
+    * SurfaceFlinger EGL, HWUI) selects zink without depending on a
+    * MESA_LOADER_DRIVER_OVERRIDE env var / mesa.loader.driver.override property
+    * being present (the property is easy to lose and the prefixed forms exceed
+    * the 32-byte property-key limit).
     */
    if (strcmp(ddev->base.driver_name, "amdgpu") == 0) {
       FREE(ddev->base.driver_name);
-      ddev->base.driver_name = strdup("radeonsi");
+      ddev->base.driver_name = strdup("zink");
    }
 
